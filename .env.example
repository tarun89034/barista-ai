# =============================================================================
# Barista AI – Environment Configuration
# =============================================================================

# ── Required ──────────────────────────────────────────────────────────────────

# Google Gemini API key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional: market data providers ──────────────────────────────────────────
# The data fetcher tries Finnhub -> Alpha Vantage -> yfinance and falls back
# cleanly when a key is absent, so these are optional. Without them the app
# still runs, but relies on yfinance alone and may be rate-limited or degraded.

# https://finnhub.io/register
FINNHUB_API_KEY=
# https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
# https://fredaccount.stlouisfed.org/apikeys  (macro/economic series)
FRED_API_KEY=

# ── Application Settings ─────────────────────────────────────────────────────

ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Risk Analysis Defaults ───────────────────────────────────────────────────

DEFAULT_CONFIDENCE_LEVEL=0.95
DEFAULT_VAR_METHOD=historical
MONTE_CARLO_SIMULATIONS=10000
HISTORICAL_LOOKBACK_DAYS=252
RISK_FREE_RATE=0.04
BENCHMARK_SYMBOL=^GSPC
BASE_CURRENCY=USD

# ── Rebalancing ──────────────────────────────────────────────────────────────

REBALANCING_THRESHOLD=0.05
MIN_CASH_RESERVE=0.05
MAX_POSITION_SIZE=0.30

# ── Market Monitor ───────────────────────────────────────────────────────────

PRICE_UPDATE_INTERVAL=60
PRICE_ALERT_THRESHOLD=0.02
API_RATE_LIMIT=60
CACHE_EXPIRATION=300

# ── API Server ───────────────────────────────────────────────────────────────

API_HOST=0.0.0.0
API_PORT=8000
API_DOCS_ENABLED=true
# Comma-separated. Only needed when the frontend is served separately from
# the API (dev). In production FastAPI serves frontend/out on the same origin.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
